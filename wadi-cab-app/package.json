{
  "name": "wadi-cab-app",
  "version": "1.0.0",
  "private": true,
  "description": "Wadi Cab — Customer ride-hailing app (Next.js + Capacitor)",
  "scripts": {
    "build": "next build",
    "build:static": "next build",
    "build:mobile": "next build && npx cap sync",
    "build:mobile:clean": "rm -rf .next out && next build && npx cap sync && npx cap copy",
    "dev": "next dev",
    "dev:android": "npx cap run android --live-reload --host=0.0.0.0 --port=3000",
    "dev:ios": "npx cap run ios --livereload",
    "cap:sync:dev": "npx cap sync android",
    "cap:open:android": "npx cap open android",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "sync": "npx cap sync",
    "lint": "next lint",
    "start": "next start"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/cli": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/geolocation": "^7.1.8",
    "@capacitor/ios": "^7.4.0",
    "@capacitor/keyboard": "^7.0.2",
    "@capacitor/network": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-toast": "1.2.4",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.454.0",
    "next": "15.2.4",
    "next-themes": "^0.4.4",
    "react": "^19",
    "react-dom": "^19",
    "socket.io-client": "^4.8.3",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.6"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
