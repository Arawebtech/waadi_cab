{
  "name": "wadi-cab-backend",
  "version": "1.0.0",
  "description": "Backend API for Wadi Cab Border Tax Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed:plans": "node scripts/seed-plans.js",
    "cleanup": "node scripts/cleanup-db.js",
    "reset:whatsapp": "node reset-whatsapp.js",
    "deploy:production": "./deploy.sh production",
    "deploy:staging": "./deploy.sh staging",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop wadi-cab-backend",
    "pm2:restart": "pm2 restart wadi-cab-backend",
    "pm2:delete": "pm2 delete wadi-cab-backend",
    "pm2:logs": "pm2 logs wadi-cab-backend",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status",
    "backup": "./backup.sh",
    "fetch:payu:yesterday": "node scripts/fetch-payu-yesterday.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "border-tax",
    "api",
    "nodejs",
    "express"
  ],
  "author": "Wadi Cab Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.16.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.4",
    "pdfkit": "^0.17.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
