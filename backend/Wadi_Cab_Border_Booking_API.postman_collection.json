              "host": ["{{base_url}}"],
              "path": ["payment", "initiate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.payment && response.data.payment.paymentData) {",
                  "        pm.collectionVariables.set('transaction_id', response.data.payment.paymentData.txnid);",
                  "        console.log('Transaction ID saved:', response.data.payment.paymentData.txnid);",
                  "        console.log('PayU Payment URL:', response.data.payment.paymentUrl);",
                  "        console.log('Use this data to POST to PayU:', JSON.stringify(response.data.payment.paymentData, null, 2));",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Get Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/payment/status/{{transaction_id}}",
              "host": ["{{base_url}}"],
              "path": ["payment", "status", "{{transaction_id}}"]
            }
          }
        },
        {
          "name": "4. Simulate PayU Success Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "mihpayid",
                  "value": "123456789",
                  "type": "text"
                },
                {
                  "key": "mode",
                  "value": "CC",
                  "type": "text"
                },
                {
                  "key": "status",
                  "value": "success",
                  "type": "text"
                },
                {
                  "key": "unmappedstatus",
                  "value": "captured",
                  "type": "text"
                },
                {
                  "key": "key",
                  "value": "your_payu_key",
                  "type": "text"
                },
                {
                  "key": "txnid",
                  "value": "{{transaction_id}}",
                  "type": "text"
                },
                {
                  "key": "amount",
                  "value": "100.00",
                  "type": "text"
                },
                {
                  "key": "productinfo",
                  "value": "Border Tax Pass - Daily - Test State",
                  "type": "text"
                },
                {
                  "key": "firstname",
                  "value": "John",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "john@example.com",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "9876543210",
                  "type": "text"
                },
                {
