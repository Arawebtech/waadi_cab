      "description": "PayU payment gateway integration endpoints",
      "item": [
        {
          "name": "1. Test PayU Configuration",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
