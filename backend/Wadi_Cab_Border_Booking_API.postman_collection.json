            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"9876543210\",\n  \"otp\": \"1234\",\n  \"verificationId\": \"verification_id_from_login\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-login",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-login"]
            }
